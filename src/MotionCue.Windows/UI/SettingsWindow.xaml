<Window x:Class="MotionCue.Windows.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MotionCue" Width="980" Height="780" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F4F6FC"
        FontFamily="Segoe UI" Foreground="#172033">
  <Window.Resources>
    <SolidColorBrush x:Key="Primary" Color="#6670E8" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#EEF0FF" />
    <SolidColorBrush x:Key="MutedText" Color="#737B91" />
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#243052" BlurRadius="18" ShadowDepth="3" Opacity="0.09"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedText}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="88"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#F0F2F8"/><Setter Property="Foreground" Value="#394158"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#4E566C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="SegmentBorder" Background="#F3F5FA" CornerRadius="10" Padding="16,10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentBorder" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SegmentBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#394158"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="4,2">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EEF0FF"/><Setter Property="Foreground" Value="#525CD7"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E5E8FF"/><Setter Property="Foreground" Value="#525CD7"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="#F5F6FA"/><Setter Property="BorderBrush" Value="#E3E6EF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
          <ContentPresenter Margin="13,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Width="40"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="#747C91" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,5,0,0" Padding="3" Background="White" BorderBrush="#E3E6EF" BorderThickness="1" CornerRadius="10">
              <Border.Effect><DropShadowEffect Color="#243052" BlurRadius="18" ShadowDepth="4" Opacity="0.14"/></Border.Effect>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Primary}"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="Background" Value="#F0F2F8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DDE1EC"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,7"/><Setter Property="Foreground" Value="#41495F"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="6" Background="#F3F5FA" BorderBrush="#CDD2E1" BorderThickness="1.3" VerticalAlignment="Center">
            <Path x:Name="CheckMark" Visibility="Collapsed" Data="M 4 9 L 8 13 L 16 5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource Primary}"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Primary}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#394158"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="34,26,34,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource Primary}">
        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,1,0,0">
        <TextBlock Text="MotionCue" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="Visual motion cues for a more comfortable ride" Foreground="{StaticResource MutedText}" FontSize="12"/>
      </StackPanel>
      <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="15,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Primary}" Margin="0,0,8,0"/><TextBlock x:Name="HeaderStatusText" Text="Checking sensor…" FontSize="12" FontWeight="SemiBold"/></StackPanel>
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34,0,34,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*" MinWidth="270"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Connect your phone" Style="{StaticResource SectionTitle}"/><TextBlock Text="Keep the MotionCue Sensor app open for the first connection." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
              <Border Grid.Column="1" Background="{StaticResource PrimarySoft}" CornerRadius="12" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="BLE" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="11"/></Border>
            </Grid>
            <Grid x:Name="PhoneSensorControls" Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="PhoneDeviceCombo" MinWidth="210" DisplayMemberPath="Name" Margin="0,0,8,0"/>
              <Button x:Name="PhoneRefreshButton" Grid.Column="1" Content="Scan" Style="{StaticResource QuietButton}" Click="PhoneRefresh_Click"/>
              <Button x:Name="PhoneConnectButton" Grid.Column="2" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="0" Click="PhoneConnect_Click"/>
            </Grid>
            <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PhoneStatusText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button x:Name="PhoneDisconnectButton" Grid.Column="1" Content="Disconnect" Style="{StaticResource QuietButton}" Padding="10,6" MinWidth="76" Margin="8,0,0,0" Click="PhoneDisconnect_Click"/>
            </Grid>
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Motion cues" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Automatic is recommended. Cues appear only when useful motion is detected." Style="{StaticResource Caption}" Margin="0,4,0,14"/>
            <UniformGrid Rows="1">
              <RadioButton x:Name="AutomaticRadio" Content="Automatic" GroupName="Mode" Tag="Automatic" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked"/>
              <RadioButton x:Name="OnRadio" Content="Always on" GroupName="Mode" Tag="On" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked"/>
              <RadioButton x:Name="OffRadio" Content="Off" GroupName="Mode" Tag="Off" Style="{StaticResource SegmentRadio}" Margin="0" Checked="Mode_Checked"/>
            </UniformGrid>
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Visual style" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Pattern" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}"/>
                <UniformGrid Rows="1" Margin="0,7,0,0"><RadioButton x:Name="RegularRadio" Content="Calm" GroupName="Pattern" Tag="Regular" Style="{StaticResource SegmentRadio}" Checked="Pattern_Checked"/><RadioButton x:Name="DynamicRadio" Content="Dynamic" GroupName="Pattern" Tag="Dynamic" Style="{StaticResource SegmentRadio}" Margin="0" Checked="Pattern_Checked"/></UniformGrid>
              </StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Dot color" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedText}"/>
                <ComboBox x:Name="ColorCombo" Margin="0,7,0,0" SelectionChanged="ColorCombo_SelectionChanged"><ComboBoxItem Content="Graphite" Tag="#6F747C"/><ComboBoxItem Content="Blue Gray" Tag="#597386"/><ComboBoxItem Content="Warm Gray" Tag="#746E69"/><ComboBoxItem Content="White" Tag="#F2F4F7"/></ComboBox>
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,13,0,0"><CheckBox x:Name="LargerDotsCheck" Content="Larger dots" Margin="0,7,24,7" Click="Appearance_Click"/><CheckBox x:Name="MoreDotsCheck" Content="More dots" Click="Appearance_Click"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Current status" Style="{StaticResource SectionTitle}"/>
            <Border Background="{StaticResource PrimarySoft}" CornerRadius="13" Padding="15" Margin="0,14,0,0"><StackPanel><TextBlock Text="SENSOR" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="StatusText" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
            <CheckBox x:Name="StartupCheck" Margin="1,16,0,0" Content="Start MotionCue with Windows" Click="Startup_Click"/>
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><Expander Header="Research session" IsExpanded="False"><StackPanel Margin="0,16,0,0">
            <TextBlock Text="Anonymous study logging. No location data is collected." Style="{StaticResource Caption}" Margin="0,0,0,13"/>
            <TextBlock Text="Participant code" FontWeight="SemiBold" FontSize="12"/><TextBox x:Name="ParticipantCodeText" Text="P01" MaxLength="40" Margin="0,5,0,10"/>
            <TextBlock Text="Session ID" FontWeight="SemiBold" FontSize="12"/><TextBox x:Name="SessionIdText" Text="S01" MaxLength="40" Margin="0,5,0,10"/>
            <TextBlock Text="Condition" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="ResearchConditionCombo" Margin="0,5,0,10" SelectedIndex="2"><ComboBoxItem Content="No Cue" Tag="NoCue"/><ComboBoxItem Content="Static Visual Control" Tag="StaticVisualControl"/><ComboBoxItem Content="Synchronized Cue" Tag="SynchronizedCue"/></ComboBox>
            <TextBlock Text="FMS interval" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="FmsIntervalCombo" Margin="0,5,0,12" SelectedIndex="1"><ComboBoxItem Content="10 seconds · QA only" Tag="10"/><ComboBoxItem Content="60 seconds · protocol" Tag="60"/></ComboBox>
            <WrapPanel><Button x:Name="StartResearchButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="StartResearch_Click"/><Button x:Name="StopResearchButton" Content="Stop &amp; save" Style="{StaticResource QuietButton}" Click="StopResearch_Click" IsEnabled="False"/></WrapPanel>
            <Button x:Name="EmergencyStopButton" Content="Emergency stop" Margin="0,9,0,0" HorizontalAlignment="Stretch" Background="#FFF0F0" Foreground="#B42318" BorderThickness="0" Click="EmergencyStop_Click" IsEnabled="False"/>
            <Separator Margin="0,15" Background="#E8EAF1"/>
            <TextBlock Text="Event marker" FontWeight="SemiBold" FontSize="12"/><Grid Margin="0,5,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MarkerText" MaxLength="200"/><Button x:Name="AddMarkerButton" Grid.Column="1" Content="Add" Style="{StaticResource QuietButton}" Margin="7,0,0,0" MinWidth="50" Click="AddMarker_Click" IsEnabled="False"/></Grid>
            <TextBlock Text="FMS score (0–20)" FontWeight="SemiBold" FontSize="12"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ManualFmsCombo" SelectedIndex="0"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/><ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="17"/><ComboBoxItem Content="18"/><ComboBoxItem Content="19"/><ComboBoxItem Content="20"/></ComboBox>
              <Button x:Name="RecordFmsButton" Grid.Column="1" Content="Record" Style="{StaticResource QuietButton}" Margin="7,0,0,0" Click="RecordFms_Click" IsEnabled="False"/>
            </Grid>
            <Border Margin="0,12,0,0" Padding="12" Background="#F5F6FA" CornerRadius="10"><StackPanel><TextBlock x:Name="ResearchStatusText" Text="No research session active" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ResearchOutputText" Margin="0,4,0,0" Style="{StaticResource Caption}"/><TextBlock Margin="0,5,0,0" Foreground="#B42318" FontSize="11" TextWrapping="Wrap" Text="Safety: Ctrl+Shift+F12 immediately stops the session."/></StackPanel></Border>
          </StackPanel></Expander></Border>

          <Border x:Name="DeveloperPanel" Visibility="Collapsed" Style="{StaticResource Card}"><StackPanel>
            <Expander Header="Diagnostics &amp; test tools"><StackPanel Margin="0,14,0,0">
              <TextBlock Text="Virtual SensorFrame replay" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <WrapPanel x:Name="SimulationControls"><Button Content="Full demo" Tag="FullDemo" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Accelerate" Tag="Accelerate" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Brake" Tag="Brake" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Turn left" Tag="TurnLeft" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Turn right" Tag="TurnRight" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Neutral" Tag="Neutral" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/><Button Content="Dropout" Tag="Dropout" Style="{StaticResource QuietButton}" Click="PhoneSimulation_Click"/></WrapPanel>
              <TextBox x:Name="DiagnosticsText" Margin="0,10,0,0" Padding="10" Height="220" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="#F7F8FB"/>
            </StackPanel></Expander>
          </StackPanel></Border>
          <StackPanel Margin="5,0,5,18">
            <TextBlock x:Name="VersionText" Text="MotionCue 0.1.0-dev" Foreground="{StaticResource MutedText}" FontSize="11" Cursor="Hand" MouseLeftButtonUp="VersionText_MouseLeftButtonUp"/>
            <TextBlock Margin="0,4,0,0" Text="Local processing · no account · no telemetry" Style="{StaticResource Caption}" FontSize="10"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
