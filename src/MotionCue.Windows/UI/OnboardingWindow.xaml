<Window x:Class="MotionCue.Windows.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to MotionCue"
        Width="500" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="MotionCue" FontSize="28" FontWeight="SemiBold" Foreground="#0B2545" />
      <TextBlock Margin="0,8,0,0" Text="Subtle motion cues for passengers using a Windows laptop." FontSize="14" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,26,0,0">
      <TextBlock Text="Before you continue" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22">
        MotionCue receives calibrated motion data from a companion phone over Bluetooth Low Energy. The phone must be rigidly mounted in the vehicle.
      </TextBlock>
      <Border Margin="0,18,0,0" Padding="14" Background="#F2F4F7" CornerRadius="6">
        <TextBlock TextWrapping="Wrap" LineHeight="21"><Run FontWeight="SemiBold">Private by design.</Run> Motion data is processed locally and location coordinates are not collected. No account, cloud upload, or telemetry is used.</TextBlock>
      </Border>
      <TextBlock Margin="0,16,0,0" Foreground="#667085" TextWrapping="Wrap" Text="Run the MotionCue phone companion, scan for the nearby sensor in Settings, then connect. Developer SensorFrame replay works without physical movement." />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ContinueButton" Content="Continue" IsDefault="True" Click="Continue_Click" />
    </StackPanel>
  </Grid>
</Window>
